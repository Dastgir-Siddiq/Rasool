# Orbit Messenger Environment Configuration
# Copy this file to .env and adjust values for local development.

# Backend Settings
PORT=8080
JWT_SECRET=super_secret_jwt_key
JWT_ISSUER=orbit_messenger
JWT_AUDIENCE=orbit_messenger_users

# Database
DB_URL=jdbc:postgresql://localhost:5432/orbitmessenger
DB_USER=orbit
DB_PASSWORD=secret

# Android
# (Place in local.properties, not here)
# API_BASE_URL=http://10.0.2.2:8080
